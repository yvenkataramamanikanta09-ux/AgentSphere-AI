# 10 MB in decimal bytes. The limit is inclusive.
MAX_UPLOAD_BYTES=10000000

# Private local objects; an absolute local path is required when overridden.
# Default: backend/.local/private_storage (resolved from the installed project).
# Settings/startup create nothing; an authorized upload initializes private storage.
# PRIVATE_STORAGE_ROOT=C:/Users/YOUR_USER/AppData/Local/AgentSphere/private_storage
UPLOAD_TIMEOUT_SECONDS=120
UPLOAD_CONCURRENCY=2

# Separate processing worker (no automatic startup or migrations).
EXTRACTION_TIMEOUT_SECONDS=60
EXTRACTION_MEMORY_MB=512
EXTRACTION_MAX_PDF_PAGES=500
EXTRACTION_MAX_TEXT_BYTES=2000000
EXTRACTION_MAX_SECTIONS=5000
EXTRACTION_OUTPUT_BYTES=20000000
DOCX_MAX_ENTRIES=1024
DOCX_MAX_EXPANDED_BYTES=40000000
DOCX_MAX_ENTRY_BYTES=20000000
DOCX_MAX_EXPANSION_RATIO=100
WORKER_LEASE_SECONDS=120
WORKER_RETRY_BASE_SECONDS=2
WORKER_POLL_SECONDS=1
RECONCILIATION_MIN_AGE_SECONDS=86400
RECONCILIATION_MAX_ENTRIES=10000

# Copy this file to .env and provide your own connection URLs, or use
# python scripts/local_postgres.py init to generate isolated local databases.
# No password or working connection is included in this example.
# DATABASE_URL=postgresql+psycopg://USER:PERCENT_ENCODED_PASSWORD@127.0.0.1:55432/agentsphere
# TEST_DATABASE_URL=postgresql+psycopg://USER:PERCENT_ENCODED_PASSWORD@127.0.0.1:55432/agentsphere_test

# Secure defaults. Generate a random key locally; never commit the real value.
ENVIRONMENT=development
APP_ORIGIN=https://localhost:8443
ALLOW_INSECURE_LOCAL_HTTP=false
# AUTH_RATE_LIMIT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
ANONYMOUS_SESSION_SECONDS=600
LOGIN_ACCOUNT_LIMIT=10
LOGIN_IP_LIMIT=30
REGISTRATION_IP_LIMIT=5
CSRF_IP_LIMIT=60

# Module 6 Stage 1 defines contracts only; these flags start nothing.
# No Qdrant/model packages, model artifacts or external embedding services are used.
SEARCH_ENABLED=false
SEARCH_INDEXING_ENABLED=false
SEARCH_HOSTED_EMBEDDINGS_ENABLED=false
SEARCH_EMBEDDING_PROVIDER=local
SEARCH_MODEL_NAME=intfloat/multilingual-e5-small
SEARCH_TOKENIZER_NAME=intfloat/multilingual-e5-small
# Explicit reviewed 40-character lowercase commit pins are required before enabling.
# SEARCH_MODEL_REVISION=REPLACE_WITH_REVIEWED_MODEL_COMMIT
# SEARCH_TOKENIZER_REVISION=REPLACE_WITH_REVIEWED_TOKENIZER_COMMIT
SEARCH_EMBEDDING_DIMENSIONS=384
# Absolute local path only; validating settings never creates it.
# SEARCH_MODEL_CACHE=C:/Users/YOUR_USER/AppData/Local/AgentSphere/models
SEARCH_OFFLINE_MODELS=true
SEARCH_TRUST_REMOTE_CODE=false
SEARCH_CHUNK_TOKENS=350
SEARCH_CHUNK_OVERLAP_TOKENS=50
# No default connection. Later stages require an explicitly reviewed private host.
# SEARCH_QDRANT_URL=https://qdrant:6333
SEARCH_QDRANT_ALLOWED_HOSTS=["localhost","127.0.0.1","::1","qdrant"]
SEARCH_ALLOW_INSECURE_LOCAL_QDRANT=false
SEARCH_QDRANT_VERIFY_TLS=true
# Generate distinct private keys locally; no usable credential is included here.
# SEARCH_QDRANT_READ_KEY=REPLACE_WITH_PRIVATE_READ_KEY
# SEARCH_QDRANT_WRITE_KEY=REPLACE_WITH_DISTINCT_PRIVATE_WRITE_KEY
# Collection names are fixed to as_<immutable profile fingerprint>.
SEARCH_COLLECTION_PREFIX=as
SEARCH_BATCH_SIZE=32
SEARCH_MAX_CHUNKS_PER_DOCUMENT=10000
SEARCH_EMBEDDING_TIMEOUT_SECONDS=60
SEARCH_QDRANT_TIMEOUT_SECONDS=10
SEARCH_WORKER_LEASE_SECONDS=180
SEARCH_WORKER_MAX_ATTEMPTS=3
SEARCH_WORKER_RETRY_BASE_SECONDS=2
SEARCH_WORKER_POLL_SECONDS=1
SEARCH_INFERENCE_CONCURRENCY=1
SEARCH_QUERY_MAX_TOKENS=256
SEARCH_QUERY_MAX_CHARACTERS=2000
SEARCH_QUERY_MAX_BODY_BYTES=16384
SEARCH_QUERY_MAX_RESULTS=50
SEARCH_QUERY_REQUESTS_PER_MINUTE=30
SEARCH_QUERY_TIMEOUT_SECONDS=15
SEARCH_RECONCILIATION_MIN_AGE_SECONDS=86400
SEARCH_RECONCILIATION_MAX_ENTRIES=10000
